{
  "uid": "cortex-overview",
  "title": "Cortex - Event Pipeline Overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Kafka Consumer Lag (by group/topic)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "kafka:consumergroup_lag_by_group",
          "legendFormat": "{{consumergroup}} / {{topic}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Notification Handler Retry Rate (5m)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "notification:handler_retry_rate5m",
          "legendFormat": "{{eventType}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Notification DLQ Rate (5m)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "custom": { "thresholdsStyle": { "mode": "line" } } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "notification:dlq_rate5m",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Search DLQ Rate (5m)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "search:dlq_rate5m",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Notification Dedup Skipped Rate (5m)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "notification:dedup_skipped_rate5m",
          "legendFormat": "dedup skipped/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Search Chunks Indexed Rate (5m) - RAG pipeline throughput",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "search:chunks_indexed_rate5m",
          "legendFormat": "chunks indexed/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Postgres Active Connections (per app DB)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "postgres:app_connections",
          "legendFormat": "{{datname}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Elasticsearch Reachable",
      "type": "stat",
      "gridPos": { "x": 12, "y": 24, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "elasticsearch_clusterinfo_up",
          "legendFormat": "reachable",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Search Handler Retry Rate (5m)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 32, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "search:handler_retry_rate5m",
          "legendFormat": "{{eventType}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Circuit Breaker State (0=closed, 1=half-open, 2=open)",
      "type": "stat",
      "gridPos": { "x": 12, "y": 32, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "circuit_breaker_state",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Circuit Breaker Transitions Rate (5m)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 40, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "circuit_breaker:transitions_rate5m",
          "legendFormat": "{{name}} -> {{state}}",
          "refId": "A"
        }
      ]
    }
  ]
}
