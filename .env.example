# ==============================================================================
# ENVIRONMENT VARIABLES - DEVELOPMENT (LOCAL DOCKER)
# ==============================================================================
# This file is used for local development running on docker-compose.
#
# Every key below is read by at least one service's Zod env schema
# (apps/*/src/config/env.*.ts) — kept in sync with those schemas by hand.
# Keys with a Zod `.default(...)` still work if you omit them, but are listed
# here explicitly so the real requirement isn't hidden behind an implicit
# fallback (see .ai/memory/conventions.jsonl, 2026-07-05).

# --- NODE ENV ---
NODE_ENV=development

# --- DATABASE (POSTGRESQL LOCAL DOCKER) ---
DB_HOST=localhost
DB_PORT=15432
DB_USER=root
DB_PASSWORD=rootpassword
# Docker compose inits this DB by default
CORE_DB_NAME=core_db
AUTH_DB_NAME=auth_db

# --- DATABASE URLS (FOR APPS) — one per service, one DB per service ---
CORE_DATABASE_URL="postgresql://root:rootpassword@localhost:15432/core_db?schema=public"
AUTH_DATABASE_URL="postgresql://root:rootpassword@localhost:15432/auth_db?schema=public"
NOTIFICATION_DATABASE_URL="postgresql://root:rootpassword@localhost:15432/notification_db?schema=public"
SEARCH_DATABASE_URL="postgresql://root:rootpassword@localhost:15432/search_db?schema=public"

# --- REDIS (LOCAL DOCKER) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- KAFKA (LOCAL DOCKER) ---
KAFKA_BROKER_PORT=9092
KAFKA_CONTROLLER_PORT=9093
# Host-facing broker address each service's kafkajs client connects to
# (comma-separated if you ever run multiple brokers).
KAFKA_BROKERS=localhost:9092
# Per-service kafkajs clientId — distinct per service so kafka-ui/broker logs
# show which service produced/consumed a message (was a real gotcha: all
# services used to report as "core-api" when this shared one clientId).
CORE_KAFKA_CLIENT_ID=core-api
NOTIFICATION_KAFKA_CLIENT_ID=notification-service
SEARCH_KAFKA_CLIENT_ID=search-service
WORKER_KAFKA_CLIENT_ID=worker-service
# Consumer group ids — one group per concern (notification fan-out vs search
# indexing), so Kafka fans the same topic out to both independently.
KAFKA_NOTIFICATION_CONSUMER_GROUP=notification-service-group
KAFKA_SEARCH_INDEXER_GROUP=search-service-indexer-group
# Bounded retry before a message is dead-lettered (ResilientEventConsumer).
KAFKA_CONSUMER_MAX_RETRIES=3
KAFKA_CONSUMER_RETRY_BACKOFF_MS=500

# --- OUTBOX (core-api Transactional Outbox + Polling Publisher) ---
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_POLL_BATCH_SIZE=50
OUTBOX_CLAIM_TIMEOUT_MS=60000

# --- ELASTICSEARCH (LOCAL DOCKER — BM25 keyword side of hybrid search) ---
ELASTIC_PORT=9200
ELASTIC_USERNAME=elastic
ELASTIC_PASSWORD=changeme
ELASTICSEARCH_URL=http://localhost:9200
# Real, persistent ES users (native realm) scoped to dsp_ops_reader /
# dsp_audit_reader roles — see docker-init/elasticsearch/setup.sh.
DSP_OPS_READER_PASSWORD=ops-reader-changeme
DSP_AUDIT_READER_PASSWORD=audit-reader-changeme
# Kibana's OWN backend connection to ES — MUST be kibana_system, not `elastic`.
KIBANA_SYSTEM_PASSWORD=kibana-system-changeme

# --- EMBEDDINGS (self-hosted Ollama — Claude has NO embeddings API) ---
EMBEDDING_SERVICE_PORT=11434
EMBEDDING_SERVICE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# --- RAG SUMMARIZATION (search-service — provider swappable behind ISummarizer) ---
SUMMARIZER_PROVIDER=claude
RAG_MODEL=claude-opus-4-8
GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_API_KEY / GEMINI_API_KEY are service-only secrets — see
# apps/search-service/.env.secrets.example, not here.

# --- APP PORTS ---
AUTH_SERVICE_PORT=4001
CORE_API_PORT=4002
NOTIFICATION_SERVICE_PORT=4003
SEARCH_SERVICE_PORT=4004
# worker-service has no HTTP server (createApplicationContext) — no port.

# --- INTERNAL gRPC (core-api -> auth-service, org provisioning) ---
AUTH_GRPC_PORT=50051
AUTH_GRPC_URL=localhost:50051
INTERNAL_GRPC_SHARED_SECRET=change-me-to-a-random-32-char-secret

# --- INTERNAL gRPC (search-service -> core-api, membership verification) ---
CORE_GRPC_PORT=50052
CORE_GRPC_URL=localhost:50052

# --- CORS ---
# NOTE: auth-service uses CORS_ORIGINS; core-api/notification-service/
# search-service use CORS_ALLOWED_ORIGINS — same purpose, inherited naming
# split, not yet unified across services.
CORS_ORIGINS=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3001

# --- LOGGING ---
LOG_LEVEL=info

# --- SECRETS (shared) ---
# Only the PUBLIC half of the JWT keypair lives here — every service needs it
# to verify a token's signature, and a public key is meant to be shared.
# JWT_PRIVATE_KEY / JWT_REFRESH_SECRET are service-only secrets (only
# auth-service signs tokens) — see apps/auth-service/.env.secrets.example,
# not here. Split done 2026-07-05, see .ai/memory/conventions.jsonl.
# Generate: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | base64 -w 0
# Public key: openssl pkey -pubout | base64 -w 0
JWT_PUBLIC_

# --- GRAFANA ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
GRAFANA_PORT=3000

# --- UIs & DASHBOARDS ---
KAFKA_UI_USER=admin
KAFKA_UI_PASSWORD=admin
KAFKA_UI_PORT=8080
REDISINSIGHT_PORT=8001
KIBANA_PORT=5601
PROMETHEUS_PORT=9090

# --- API GATEWAY ---
API_GATEWAY_PORT=8000

# --- EXPORTERS ---
NODE_EXPORTER_PORT=9100
POSTGRES_EXPORTER_PORT=9187
REDIS_EXPORTER_PORT=9121
KAFKA_EXPORTER_PORT=9308
ELASTICSEARCH_EXPORTER_PORT=9114
NGINX_EXPORTER_PORT=9113
